# Copy this file to .env and fill in the keys you have. Never commit .env (it is in .gitignore).
# Phase 0 (the paper reader and the search) needs NO key. The keys are for the agent (Phase 1).

# Hugging Face Inference Providers (open models; uses your account's credits)
HF_TOKEN=
USE_HF=1
HF_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731:deepinfra
HF_FALLBACK_MODEL=openai/gpt-oss-120b:deepinfra
MAX_HF_CALLS=300          # per run (command line); 0 = no cap
DAILY_HF_CALLS=0          # per UTC day; the Space uses 150

# Groq (free tier)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Google Gemini (free tier)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Local Ollama (optional, slow)
USE_OLLAMA=0
OLLAMA_MODEL=qwen3:8b

# OpenAI (PAID; development only, never on the public Space)
OPENAI_API_KEY=
ALLOW_OPENAI=0
MAX_OPENAI_CALLS=20

PROVIDER_ORDER=hf,hf_backup,groq,groq_backup,gemini,ollama

# Search
EMBEDDINGS=fastembed      # fastembed | none (BM25 only) | hash (offline stand-in, tests only)
EMBED_MODEL=snowflake/snowflake-arctic-embed-s
FASTEMBED_CACHE_PATH=fastembed_cache    # where the embedding models are kept; outside OneDrive if you use it
EMB_CACHE_PATH=results/emb_cache        # eval_retrieval.py's cache of passage embeddings; outside OneDrive too
DOMAIN=none               # none | physics (BM25 synonyms; measured: no gain)
MAX_PASSAGE_CHARS=1200

# Web app limits per visitor (0 = no limit)
QUESTIONS_PER_HOUR=0                # per session (the Space: 40)
QUESTIONS_PER_ADDRESS_HOUR=0        # per network address (the Space: 120)
MAX_QUESTION_CHARS=600
MAX_PDF_MB=20
MAX_PDF_PAGES=100
MAX_PAPERS_PER_SESSION=5

# Corpus download (fetch_papers.py); optional: an e-mail address puts you in OpenAlex's faster "polite pool"
OPENALEX_MAILTO=
OPENALEX_API_KEY=         # optional, free (openalex.org/settings/api): its own daily budget
PAPERS_DIR=papers
